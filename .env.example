# OrbitoDB — copy this file to ".env" and edit as needed.
#   cp .env.example .env

# Which published image tag to run ("latest", or a version like "v0.1.0").
ORBITODB_VERSION=latest

# Host port for the web UI (open http://localhost:<WEB_PORT>).
WEB_PORT=5001

# Host interface for the web UI. OrbitoDB has no login, so the secure default is
# localhost only. Widen this deliberately only when the surrounding network is
# trusted or access is protected by a VPN/reverse proxy.
#   BIND_ADDR=127.0.0.1        # this machine only
#   BIND_ADDR=100.x.y.z        # a VPN/Tailscale address
BIND_ADDR=127.0.0.1

# Demo database credentials (used by the bundled postgres/mysql services).
DB_USERNAME=orbitodb
DB_PASSWORD=orbitodb
DB_DATABASE=demo

# Host ports for the demo databases (only needed for direct/external access).
PG_PORT=5433
MYSQL_PORT=3307

# Which interface those demo-database ports are published on. They use the
# well-known password above, so they default to localhost only. The app itself
# doesn't use these ports — it reaches the databases over the compose network —
# so widen this only to attach an external client from another machine.
DB_BIND_ADDR=127.0.0.1


# Bridge listener. Keep the local npm-run bridge bound to loopback by default.
# Docker Compose overrides this to 0.0.0.0 inside the private compose network.
BRIDGE_HOST=127.0.0.1
# Optional comma-separated cross-origin allowlist for direct bridge access.
# Same-origin nginx/Vite proxy traffic does not require CORS.
# BRIDGE_ORIGINS=http://localhost:1420,http://localhost:5001
# Maximum JSON request body accepted by the bridge (default 16 MiB).
# BRIDGE_MAX_BODY_BYTES=16777216
